# Task 2

trap 'printf "\nДля выхода из игры введите q или Q.\n"' INT

secret=''
while ((${#secret} < 4)); do
    digit=$((RANDOM % 10))
    if [[ -z $secret && $digit == 0 ]]; then
        continue
    fi
    if [[ $secret != *"$digit"* ]]; then
        secret+="$digit"
    fi
done

turn=1
history=()

printf '%s\n' 'Быки и коровы'
printf '%s\n' 'Я загадал 4-значное число с неповторяющимися цифрами.'
printf '%s\n' 'Попробуйте его угадать. Для выхода введите q или Q.'

while true; do
    if IFS= read -r -p "Попытка $turn: " guess; then
        :
    else
        read_status=$?
        if ((read_status > 128)); then
            continue
        fi
        printf '\nВвод завершён.\n'
        exit 1
    fi

    case $guess in
        q|Q)
            printf 'Игра завершена.\n'
            exit 1
            ;;
    esac

    if [[ ! $guess =~ ^[1-9][0-9]{3}$ ]]; then
        printf 'Ошибка: введите 4-значное число без повторяющихся цифр.\n'
        continue
    fi

    unique=true
    for ((i = 0; i < 4; i++)); do
        for ((j = i + 1; j < 4; j++)); do
            if [[ ${guess:i:1} == "${guess:j:1}" ]]; then
                unique=false
                break 2
            fi
        done
    done
    if [[ $unique == false ]]; then
        printf 'Ошибка: цифры в числе не должны повторяться.\n'
        continue
    fi

    bulls=0
    cows=0
    for ((i = 0; i < 4; i++)); do
        digit=${guess:i:1}
        if [[ $digit == "${secret:i:1}" ]]; then
            ((bulls += 1))
        elif [[ $secret == *"$digit"* ]]; then
            ((cows += 1))
        fi
    done

    printf 'Коров - %d, Быков - %d\n' "$cows" "$bulls"
    history+=("$turn. $guess (Коров - $cows Быков - $bulls)")

    printf 'История ходов:\n'
    printf '%s\n' "${history[@]}"
    printf '\n'

    if ((bulls == 4)); then
        printf 'Вы угадали число %s! Количество попыток: %d.\n' "$secret" "$turn"
        exit 0
    fi

    ((turn += 1))
done

